Algoritmo "dobro-terca-parte"

Var
   numero, dobro, tercaParte: real
Inicio
   Escreval ("Digite um número: ")
   Leia (numero)
   
   dobro <- numero * 2
   Escreval ("O dobro de", numero," é:", dobro)
   tercaParte <- numero / 3
   Escreval ("A terça parte de", numero, " é:", tercaParte)
Fimalgoritmo