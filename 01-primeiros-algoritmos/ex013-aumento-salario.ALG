Algoritmo "aumento-salario"
Var
   salario, aumento: real
Inicio
   Escreval ("Digite o valor do salário: ")
   Leia (salario)
   
   aumento <- (salario * 15) / 100
   Escreval ("O salário de R$", salario, " passará a ser de R$", salario+aumento)
   Escreval ("O aumento de 15% foi de: R$", aumento)

Fimalgoritmo